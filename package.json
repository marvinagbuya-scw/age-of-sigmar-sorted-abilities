{
  "name": "age-of-sigmar-sorted-abilities",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run lint && npm run validate:data && ng test",
    "test:unit": "ng test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \".storybook/*.ts\" \"scripts/*.mts\" \"public/data/**/*.json\" \"*.md\"",
    "validate:data": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-data.mts",
    "storybook": "ng run age-of-sigmar-sorted-abilities:storybook",
    "build-storybook": "ng run age-of-sigmar-sorted-abilities:build-storybook"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.5.2",
    "@angular-devkit/architect": "^0.2201.0",
    "@angular-devkit/build-angular": "^22.1.0",
    "@angular-devkit/core": "^22.1.0",
    "@angular/animations": "^22.1.0",
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/angular-vite": "^10.6.0",
    "@types/node": "^20",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10.10.0",
    "eslint-plugin-jsonc": "^3.4.2",
    "jsdom": "^28.0.0",
    "playwright": "latest",
    "prettier": "^3.8.1",
    "storybook": "^10.6.0",
    "typescript": "~6.0.2",
    "vite": "latest",
    "vitest": "^4.0.8"
  }
}
